        <text x="14" y="64" font-family="Space Grotesk, sans-serif" font-size="13.5" font-weight="700" fill="var(--svg-text)">&Phi;_IR Binary Bus</text>
        <text x="14" y="88" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--svg-muted)">927.30 &micro;J Thor shunt</text>
        <text x="14" y="104" font-family="JetBrains Mono, monospace" font-size="9.5" fill="#00D4AA">0 / 200 faults leaked</text>
      </g>

      <!-- Loop 2 -->
      <g transform="translate(244, 84)">
        <rect width="184" height="124" rx="8" fill="var(--svg-panel)" stroke="rgba(245,158,11,0.4)" stroke-width="1.3" />
        <text x="14" y="24" font-family="JetBrains Mono, monospace" font-size="10" font-weight="700" fill="#F59E0B">LOOP 2 &middot; CALIBRATE</text>
        <text x="14" y="46" font-family="Space Grotesk, sans-serif" font-size="13.5" font-weight="700" fill="var(--svg-text)">1-Pass Hardware</text>
        <text x="14" y="64" font-family="Space Grotesk, sans-serif" font-size="13.5" font-weight="700" fill="var(--svg-text)">cost_lut.json</text>
        <text x="14" y="88" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--svg-muted)">0 gradient epochs</text>
        <text x="14" y="104" font-family="JetBrains Mono, monospace" font-size="9.5" fill="#00D4AA">K &middot; m probe pass (T40)</text>
      </g>

      <!-- Loop 3 -->
