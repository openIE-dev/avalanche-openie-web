  <!-- Interactive Live CpJ Payback Simulator -->
  <div class="glass-card p-6 md:p-8 space-y-6 border-brand-cyan/30" data-reveal>
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-5 border-b border-brand-border">
      <div>
        <p class="section-label-cyan mb-2">Interactive Instrument &middot; Proposition 1, CTA-T41, CTA-T43, &amp; CTA-T45</p>
        <h3 class="font-display text-2xl md:text-3xl font-bold text-brand-white tracking-tight">
          Live Coherence-per-Joule (<code class="code-chip">CpJ</code>) Payback &amp; Horizon Simulator
        </h3>
        <p class="font-body text-sm text-brand-slate mt-1 max-w-3xl">
          Simulate <code class="code-chip">K = 22</code> structural task classes arriving under a Zipfian stream (<code class="code-chip">CTA</code> Worked Example 5 generalized). Adjust horizon <em>N</em>, Zipf recurrence skew <em>s</em>, frontier wake energy <em>c</em><sub>3</sub>, and per-class compilation budget <em>E</em><sub>compile</sub> to inspect exact payback <em>N</em>*, 4-tier downward promotion (<code class="code-chip">Tier 3 &rarr; Tier 2 &rarr; Tier 1 DNULLMM1 &rarr; Tier 0 LUT6</code>), and automatic <em>h</em><sub>min</sub> eviction.
        </p>
      </div>
      <button
        id="sim-reset-btn"
        type="button"
        class="shrink-0 font-mono text-xs text-brand-cyan border border-brand-cyan/40 px-3.5 py-2 rounded-lg bg-transparent hover:bg-brand-cyan/10 cursor-pointer transition-colors"
