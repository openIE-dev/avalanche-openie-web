  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4" data-reveal>
    {FIVE_LOOPS.map((item) => (
      <div class="glass-card spotlight-card p-4 flex flex-col justify-between space-y-3">
        <div class="space-y-2">
          <div class="font-mono text-[10.5px] uppercase tracking-wider text-brand-cyan font-semibold">{item.loop}</div>
          <h4 class="font-display text-base font-bold text-brand-white leading-snug">{item.name}</h4>
          <p class="reg-visionary font-body text-xs text-brand-slate leading-relaxed">{item.summary}</p>
          <p class="reg-scientist font-mono text-[11px] text-brand-cyan bg-brand-dark/55 px-2.5 py-1.5 rounded border border-brand-border">{item.formalSpec}</p>
