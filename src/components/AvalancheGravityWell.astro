---
// Airy 4-Altitude Simplest-First Editorial Spread for avalanche.openie.dev (Placed calmly below the Hero)
---

<section
  id="plain-story"
  aria-labelledby="gw-avalanche-heading"
  class="max-w-5xl mx-auto px-6 py-28 md:py-36 relative z-10"
>
  <div class="space-y-12 md:space-y-16 min-w-0">
    <!-- Open Editorial Header -->
    <div class="space-y-5 max-w-3xl" data-reveal>
      <div class="flex flex-wrap items-center gap-4 font-mono text-[11px] uppercase tracking-[0.18em] text-brand-cyan">
        <span>Start Here &middot; Plain Story</span>
        <span class="text-brand-border" aria-hidden="true">|</span>
        <a
          href="/planetary/"
          class="text-brand-emerald no-underline hover:underline tracking-normal normal-case"
        >
          &#9670; 1,315 Recipes
        </a>
        <a
          href="https://research.openie.dev/tv/?channel=avalanche"
          class="text-brand-amber no-underline hover:underline tracking-normal normal-case"
        >
          &#9654; 145 Films
        </a>
        <a
          href="https://research.openie.dev/radio/?desk=avalanche"
          class="text-brand-slate no-underline hover:text-brand-cyan transition-colors tracking-normal normal-case"
        >
          &#9673; 17 Broadcasts
        </a>
      </div>

      <h2
        id="gw-avalanche-heading"
        class="font-display text-3xl sm:text-4xl md:text-[46px] font-bold text-brand-white tracking-tight leading-[1.1]"
      >
        Stop bushwhacking off-road on every commute &mdash; <span class="text-brand-cyan">freeze proven AI routes into fast microjoule tracks.</span>
      </h2>
    </div>

    <!-- Spacious Pull-Quote / Everyday Analogy Block -->
    <div class="glass-card spotlight-card p-8 md:p-12 border-l-2 border-l-brand-cyan" data-reveal>
      <div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-brand-cyan mb-4">
        Everyday Analogy &middot; Ice Tracks vs. Off-Road Bushwhacking
      </div>
      <p class="font-body text-xl md:text-2xl text-brand-light leading-relaxed m-0 font-normal">
        Crossing an unmapped mountain pass for the first time takes a heavy off-road vehicle burning gallons of fuel. Once thousands of travelers need that exact crossing, you <strong class="text-brand-white font-semibold">pave a smooth highway</strong> &mdash; or let meltwater <strong class="text-brand-white font-semibold">freeze into clean ice tracks</strong> &mdash; so every future trip glides across for a tiny fraction of the energy. Once an AI solves and independently checks a task enough times, the <strong class="text-brand-cyan font-semibold">9-Rung Avalanche Ratchet</strong> compiles that route into microjoule lookup tables and hardware logic.
      </p>
    </div>

    <!-- Three Open 01 / 02 / 03 Editorial Columns (And · But · Therefore) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 pt-2" data-reveal>
      <div class="border-t border-brand-amber/40 pt-6 space-y-2.5">
        <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-amber">
          01 &middot; And (Rungs 1&ndash;5)
        </div>
        <h3 class="font-display text-lg font-bold text-brand-white">
          Trailblazing needs search
        </h3>
        <p class="font-body text-[15px] text-brand-slate leading-relaxed m-0">
          Flexible search, drafting, and tool loops are essential when scouting unfamiliar problems where no map exists yet.
        </p>
      </div>

      <div class="border-t border-brand-cyan/35 pt-6 space-y-2.5">
        <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-cyan">
          02 &middot; But
        </div>
        <h3 class="font-display text-lg font-bold text-brand-white">
          Bushwhacking repeats burns power
        </h3>
        <p class="font-body text-[15px] text-brand-slate leading-relaxed m-0">
          Waking giant floating-point models cold on routine, already-solved tasks wastes joules and lets small errors snowball across multi-step handoffs.
        </p>
      </div>

      <div class="border-t border-brand-emerald pt-6 space-y-2.5">
        <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-emerald">
          03 &middot; Therefore (Rungs 6&ndash;9)
        </div>
        <h3 class="font-display text-lg font-bold text-brand-white">
          Ratchet into ice tracks
        </h3>
        <p class="font-body text-[15px] text-brand-light leading-relaxed m-0">
          Gate every candidate answer against an independent check once, then lock proven routines into deterministic code and microjoule circuits.
        </p>
      </div>
    </div>

    <!-- Sleek Interactive 4-Stage Lowering Tabs Bar -->
    <div class="space-y-5 pt-2" data-reveal>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-cyan">
          How Routes Freeze Downward (4 Stages)
        </span>
        <span class="font-body text-xs text-brand-gray">
          Tap each stage to trace how verified discoveries crystallize
        </span>
      </div>

      <div
        class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 p-1.5 rounded-2xl border border-brand-border bg-brand-white/[0.02]"
        role="tablist"
        aria-label="Four-stage crystallization cascade"
      >
        <button
          type="button"
          data-av-stage="s1"
          aria-selected="true"
          class="av-stage-btn text-left px-4 py-3.5 rounded-xl border border-brand-cyan bg-brand-cyan/10 cursor-pointer transition-all min-w-0"
        >
          <div class="font-mono text-xs font-bold text-brand-cyan">01 &middot; Ice-Track LUT</div>
          <div class="font-body text-xs text-brand-light mt-1">Zero-FLOP table reflex</div>
        </button>
        <button
          type="button"
          data-av-stage="s2"
          aria-selected="false"
          class="av-stage-btn text-left px-4 py-3.5 rounded-xl border border-transparent bg-transparent hover:bg-brand-white/[0.03] cursor-pointer transition-all min-w-0"
        >
          <div class="font-mono text-xs font-bold text-brand-white">02 &middot; Signed Index</div>
          <div class="font-body text-xs text-brand-gray mt-1">Zero-copy binary frame</div>
        </button>
        <button
          type="button"
          data-av-stage="s3"
          aria-selected="false"
          class="av-stage-btn text-left px-4 py-3.5 rounded-xl border border-transparent bg-transparent hover:bg-brand-white/[0.03] cursor-pointer transition-all min-w-0"
        >
          <div class="font-mono text-xs font-bold text-brand-white">03 &middot; Exact Solver</div>
          <div class="font-body text-xs text-brand-gray mt-1">Local integer silicon</div>
        </button>
        <button
          type="button"
          data-av-stage="s4"
          aria-selected="false"
          class="av-stage-btn text-left px-4 py-3.5 rounded-xl border border-transparent bg-transparent hover:bg-brand-white/[0.03] cursor-pointer transition-all min-w-0"
        >
          <div class="font-mono text-xs font-bold text-brand-white">04 &middot; Trailblazer Tail</div>
          <div class="font-body text-xs text-brand-gray mt-1">Scout once, then compile</div>
        </button>
      </div>

      <div class="glass-card p-6 md:p-8">
        <div id="av-stage-title" class="font-mono text-xs uppercase tracking-[0.14em] font-semibold text-brand-cyan mb-2">
          Stage 01 &middot; Crystalline Lookup Track (Nanoujoules to Microjoules)
        </div>
        <p id="av-stage-desc" class="font-body text-base md:text-lg text-brand-light leading-relaxed m-0">
          Settled routes lock directly into 64-bit hardware truth tables (LUT6) and memory-mapped dictionaries &mdash; gliding across in a single cycle without waking floating-point cores.
        </p>
      </div>
    </div>

    <!-- Quiet One-Line Whisper in Default Plain Mode -->
    <p class="gw-plain-whisper font-mono text-[11px] text-brand-gray text-center pt-2 m-0">
      Signed Provenance &middot; Self-Checked &middot; Switch to
      <button type="button" data-gw-jump-depth="visual" class="text-brand-cyan underline bg-transparent border-none p-0 font-mono text-[11px] cursor-pointer">Visual</button>
      or
      <button type="button" data-gw-jump-depth="builder" class="text-brand-cyan underline bg-transparent border-none p-0 font-mono text-[11px] cursor-pointer">Builder</button>
      depth above for simulators &amp; raw receipts.
    </p>

    <!-- Depth 2 & 3 Progressive Drawers (Hidden cleanly in Plain mode; revealed at Depths 2, 3, and 4) -->
    <div class="space-y-4">
      <details
        data-gw-min-depth="visual"
        class="gw-altitude-details glass-card overflow-hidden"
      >
        <summary class="flex items-center justify-between gap-3 px-6 py-4 cursor-pointer select-none hover:bg-brand-cyan/[0.04] transition-colors">
          <div class="min-w-0">
            <span class="font-mono text-[11px] uppercase tracking-[0.15em] text-brand-cyan font-semibold">
              Depth 2 &middot; Visual &amp; Hands-On
            </span>
            <span class="font-body text-xs text-brand-slate ml-3 hidden sm:inline">
              Planetary Digital Well (1,315 Lowering Recipes), 145 Films &amp; 17 Broadcasts
            </span>
          </div>
          <span class="gw-chevron font-mono text-xs text-brand-cyan transition-transform shrink-0" aria-hidden="true">&#9662;</span>
        </summary>
        <div class="px-6 pb-6 pt-4 border-t border-brand-border grid grid-cols-1 md:grid-cols-3 gap-5">
          <a
            href="/planetary/"
            class="p-5 rounded-xl border border-brand-border bg-brand-dark/40 no-underline hover:border-brand-cyan/40 transition-colors block min-w-0"
          >
            <div class="font-mono text-[10px] text-brand-emerald uppercase tracking-wider">Interactive Observatory</div>
            <div class="font-display text-base font-bold text-brand-white mt-1.5">Planetary Digital Well (1,315) &rarr;</div>
            <p class="font-body text-xs text-brand-slate mt-2 leading-relaxed m-0">
              Explore 1,315 codified tools and 64 developer staples with explicit Stage 4 &rarr; 1 compilation recipes.
            </p>
          </a>
          <a
            href="https://research.openie.dev/tv/?channel=avalanche"
            class="p-5 rounded-xl border border-brand-border bg-brand-dark/40 no-underline hover:border-brand-amber/40 transition-colors block min-w-0"
          >
            <div class="font-mono text-[10px] text-brand-amber uppercase tracking-wider">Research TV &middot; 145 Films</div>
            <div class="font-display text-base font-bold text-brand-white mt-1.5">Watch Avalanche Films &nearr;</div>
            <p class="font-body text-xs text-brand-slate mt-2 leading-relaxed m-0">
              Short visual walkthroughs of evolutionary ratchets, compilation thresholds, and hardware shunt measurements.
            </p>
          </a>
          <a
            href="https://research.openie.dev/radio/?desk=avalanche"
            class="p-5 rounded-xl border border-brand-border bg-brand-dark/40 no-underline hover:border-brand-cyan/40 transition-colors block min-w-0"
          >
            <div class="font-mono text-[10px] text-brand-cyan uppercase tracking-wider">Research Radio &middot; 17 Broadcasts</div>
            <div class="font-display text-base font-bold text-brand-white mt-1.5">Listen to 17 Broadcasts &nearr;</div>
            <p class="font-body text-xs text-brand-slate mt-2 leading-relaxed m-0">
              Multi-voice audio deep-dives examining biological parallels, AI winters, and falsifiable forecasting rules.
            </p>
          </a>
        </div>
      </details>

      <details
        data-gw-min-depth="builder"
        class="gw-altitude-details glass-card overflow-hidden"
      >
        <summary class="flex items-center justify-between gap-3 px-6 py-4 cursor-pointer select-none hover:bg-brand-cyan/[0.04] transition-colors">
          <div class="min-w-0">
            <span class="font-mono text-[11px] uppercase tracking-[0.15em] text-brand-cyan font-semibold">
              Depth 3 &middot; Builder &amp; Evidence
            </span>
            <span class="font-body text-xs text-brand-slate ml-3 hidden sm:inline">
              7 Standalone Apache-2.0 Kits &middot; 29 [G0–G12] Source Sheets &middot; Signed Provenance
            </span>
          </div>
          <span class="gw-chevron font-mono text-xs text-brand-cyan transition-transform shrink-0" aria-hidden="true">&#9662;</span>
        </summary>
        <div class="px-6 pb-6 pt-4 border-t border-brand-border space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 rounded-xl border border-brand-cyan/25 bg-brand-cyan/[0.04]">
            <span class="font-mono text-[11px] text-brand-white font-semibold">
              Signed Provenance &middot; Self-Checked
            </span>
            <span class="font-mono text-[11px] text-brand-cyan break-words">
              measured_j &perp; reported_j &perp; est_j &perp; unmetered
            </span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <a
              href="https://research.openie.dev/replication/"
              class="p-5 rounded-xl border border-brand-border bg-brand-dark/40 no-underline hover:border-brand-cyan/40 transition-colors block min-w-0"
            >
              <div class="font-mono text-[10px] text-brand-cyan uppercase tracking-wider">Reproduce Locally &middot; Open Source</div>
              <div class="font-display text-base font-bold text-brand-white mt-1.5">7 Standalone Apache-2.0 Kits &nearr;</div>
              <p class="font-body text-xs text-brand-slate mt-2 leading-relaxed m-0">
                Download zero-dependency replication bundles and verify the self-checking harnesses on your own machine.
              </p>
            </a>
            <a
              href="https://research.openie.dev/sourcesheets/"
              class="p-5 rounded-xl border border-brand-border bg-brand-dark/40 no-underline hover:border-brand-cyan/40 transition-colors block min-w-0"
            >
              <div class="font-mono text-[10px] text-brand-cyan uppercase tracking-wider">Audit Trail &middot; [G0–G12] Gates</div>
              <div class="font-display text-base font-bold text-brand-white mt-1.5">29 [G0–G12] Source Sheets &nearr;</div>
              <p class="font-body text-xs text-brand-slate mt-2 leading-relaxed m-0">
                Inspect Lean 4 proof manifests, hardware shunt receipts, and SHA-256 digests across all 29 studies.
              </p>
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var STAGES = {
      s1: {
        title: 'Stage 01 · Crystalline Lookup Track (Nanojoules to Microjoules)',
        desc: 'Settled routes lock directly into 64-bit hardware truth tables (LUT6) and memory-mapped dictionaries — gliding across in a single cycle without waking floating-point cores.'
      },
      s2: {
        title: 'Stage 02 · Content-Addressed Signed Index (Zero-Copy)',
        desc: 'Verified solutions are indexed by canonical structure and exchanged as compact binary WAI1 frames instead of re-parsing verbose natural-language transcripts.'
      },
      s3: {
        title: 'Stage 03 · Deterministic Local Integer & Classical Solvers',
        desc: 'Structured constraints run on bit-exact integer kernels and SAT/SMT solvers across owned local silicon with zero cross-architecture drift.'
      },
      s4: {
        title: 'Stage 04 · Exploratory Frontier Synthesis (Scout Once, Lower Immediately)',
        desc: 'Heavy probabilistic models are reserved strictly for genuinely novel mountain passes — gated against hard verification checks (C(z) = 1) and compiled downward for the next trip.'
      }
    };
    var btns = document.querySelectorAll('[data-av-stage]');
    var titleEl = document.getElementById('av-stage-title');
    var descEl = document.getElementById('av-stage-desc');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var key = btn.getAttribute('data-av-stage') || 's1';
        var item = STAGES[key];
        if (!item) return;
        btns.forEach(function (b) {
          var active = b === btn;
          b.setAttribute('aria-selected', String(active));
          b.classList.toggle('border-brand-cyan', active);
          b.classList.toggle('bg-brand-cyan/10', active);
          b.classList.toggle('border-transparent', !active);
          b.classList.toggle('bg-transparent', !active);
        });
        if (titleEl) titleEl.textContent = item.title;
        if (descEl) descEl.textContent = item.desc;
      });
    });
  })();
</script>
