      jump15.addEventListener('click', function () {
        var btn15 = document.querySelector('[data-av-film-btn="15s"]');
        if (btn15) btn15.click();
      });
    }

    var canvas = document.getElementById('avalanche-hero-canvas');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var width = 0;
    var height = 0;
    var tracks = [];
    var sparks = [];
    var pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999, active: false };
    var visible = true;
    var rafId = 0;

    function isLight() {
      return document.documentElement.getAttribute('data-theme') === 'light';
    }

    function initCascade() {
      var rect = canvas.parentElement ? canvas.parentElement.getBoundingClientRect() : { width: window.innerWidth, height: window.innerHeight };
      width = Math.max(320, Math.floor(rect.width));
      height = Math.max(480, Math.floor(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Crystalline cyan horizontal rails in the lower half (Rungs 6–9)
      tracks = [];
      var trackCount = height < 640 ? 4 : 6;
      var startY = height * 0.56;
      var spanY = height * 0.34;
      for (var t = 0; t < trackCount; t++) {
        tracks.push({
          y: startY + (spanY * t) / Math.max(1, trackCount - 1),
          nodes: Math.max(5, Math.floor(width / 150))
        });
      }

      // Warm amber exploratory sparks drifting down and locking into crystalline cyan rails
      sparks = [];
      var count = width < 640 ? 28 : 52;
      for (var i = 0; i < count; i++) {
        sparks.push(makeSpark(true));
      }
    }

    function makeSpark(initialSpread) {
      var trackIdx = Math.floor(Math.random() * Math.max(1, tracks.length));
      var targetY = tracks[trackIdx] ? tracks[trackIdx].y : height * 0.68;
      var locked = initialSpread ? Math.random() < 0.42 : false;
      return {
        x: Math.random() * width,
        y: locked ? targetY : (initialSpread ? Math.random() * (height * 0.54) : -12 - Math.random() * 60),
        vx: locked ? (1.15 + Math.random() * 1.1) * (Math.random() < 0.5 ? 1 : -1) : (Math.random() - 0.5) * 0.85,
        vy: locked ? 0 : (0.55 + Math.random() * 0.75),
        targetY: targetY,
        locked: locked,
        lockBlend: locked ? 1 : 0,
        phase: Math.random() * Math.PI * 2,
        r: 1.5 + Math.random() * 1.3
      };
    }

    function renderFrame(ts) {
      var time = (ts || 0) * 0.001;
      ctx.clearRect(0, 0, width, height);
      var light = isLight();
      var thresholdY = height * 0.53;

      if (pointer.active) {
        pointer.x += (pointer.tx - pointer.x) * 0.08;
        pointer.y += (pointer.ty - pointer.y) * 0.08;
      }

      // Subtle Compilation Threshold horizon line (C(z) = 1)
      var horizonGrad = ctx.createLinearGradient(0, thresholdY, width, thresholdY);
      var hAlpha = light ? 0.12 : 0.14;
      horizonGrad.addColorStop(0, 'rgba(245, 158, 11, 0)');
      horizonGrad.addColorStop(0.28, 'rgba(245, 158, 11, ' + hAlpha + ')');
      horizonGrad.addColorStop(0.72, 'rgba(0, 212, 170, ' + hAlpha + ')');
      horizonGrad.addColorStop(1, 'rgba(0, 212, 170, 0)');
      ctx.strokeStyle = horizonGrad;
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 6]);
      ctx.beginPath();
      ctx.moveTo(0, thresholdY);
      ctx.lineTo(width, thresholdY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Draw calm crystalline tracks in lower zone
      for (var t = 0; t < tracks.length; t++) {
        var tr = tracks[t];
        var tAlpha = light ? 0.09 : 0.085;
        ctx.strokeStyle = light
          ? 'rgba(13, 148, 136, ' + tAlpha + ')'
          : 'rgba(0, 212, 170, ' + tAlpha + ')';
        ctx.lineWidth = 0.8;
        ctx.beginPath();
        ctx.moveTo(0, tr.y);
        ctx.lineTo(width, tr.y);
        ctx.stroke();

        // Subtle lattice tick nodes along each crystalline rail
        var step = width / tr.nodes;
        ctx.fillStyle = light ? 'rgba(13, 148, 136, 0.18)' : 'rgba(0, 212, 170, 0.18)';
        for (var n = 1; n < tr.nodes; n++) {
          ctx.beginPath();
          ctx.arc(n * step, tr.y, 1.4, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Update & draw sparks transitioning from warm amber drift into crystalline cyan tracks
      for (var i = 0; i < sparks.length; i++) {
        var s = sparks[i];
        if (!reducedMotion) {
          if (!s.locked) {
            // Gentle thermal drift above the threshold
            s.x += s.vx + Math.sin(time * 1.4 + s.phase) * 0.35;
            s.y += s.vy;

            // Mouse cursor gently guides nearby sparks toward crystallization
            if (pointer.active) {
              var dx = pointer.x - s.x;
              var dy = pointer.y - s.y;
              var dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 180 && dist > 1) {
                s.x += (dx / dist) * 0.65;
                s.y += (dy / dist) * 0.35;
              }
            }

            if (s.y >= s.targetY) {
              s.y = s.targetY;
              s.locked = true;
              s.vx = (1.25 + Math.random() * 1.15) * (s.vx >= 0 ? 1 : -1);
              s.vy = 0;
            }
          } else {
            s.lockBlend = Math.min(1, s.lockBlend + 0.035);
            s.x += s.vx;
            if (s.x < -30 || s.x > width + 30) {
              sparks[i] = makeSpark(false);
              continue;
            }
          }

          if (s.x < -30) s.x = width + 20;
          if (s.x > width + 30) s.x = -20;
        }

        // Color blend: Amber (245, 158, 11) -> Cyan (0, 212, 170)
        var progress = s.locked ? (0.65 + 0.35 * s.lockBlend) : Math.max(0, Math.min(0.6, s.y / Math.max(1, s.targetY) * 0.55));
        var rC = Math.round(245 + (0 - 245) * progress);
        var gC = Math.round(158 + (212 - 158) * progress);
        var bC = Math.round(11 + (170 - 11) * progress);
        if (light) {
          rC = Math.round(217 + (13 - 217) * progress);
          gC = Math.round(119 + (148 - 119) * progress);
          bC = Math.round(6 + (136 - 6) * progress);
        }

        if (s.locked) {
          // Draw sleek crystalline light streak along the track
          var trailLen = 22 * s.lockBlend * (s.vx >= 0 ? -1 : 1);
          var streak = ctx.createLinearGradient(s.x + trailLen, s.y, s.x, s.y);
          streak.addColorStop(0, 'rgba(' + rC + ',' + gC + ',' + bC + ', 0)');
          streak.addColorStop(1, 'rgba(' + rC + ',' + gC + ',' + bC + ', ' + (light ? '0.58' : '0.68') + ')');
          ctx.strokeStyle = streak;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(s.x + trailLen, s.y);
          ctx.lineTo(s.x, s.y);
          ctx.stroke();
        }

        ctx.fillStyle = 'rgba(' + rC + ',' + gC + ',' + bC + ', ' + (light ? '0.62' : '0.72') + ')';
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.locked ? 2.0 : s.r, 0, Math.PI * 2);
        ctx.fill();
      }

      if (!reducedMotion && visible) {
        rafId = window.requestAnimationFrame(renderFrame);
      }
    }

    initCascade();
    renderFrame(0);

    var heroSec = document.getElementById('hero');
    if (heroSec && !reducedMotion) {
      heroSec.addEventListener('mousemove', function (ev) {
        var r = canvas.getBoundingClientRect();
        pointer.tx = ev.clientX - r.left;
        pointer.ty = ev.clientY - r.top;
        if (!pointer.active) {
          pointer.x = pointer.tx;
          pointer.y = pointer.ty;
          pointer.active = true;
        }
      }, { passive: true });
      heroSec.addEventListener('mouseleave', function () {
        pointer.active = false;
      }, { passive: true });
    }

    window.addEventListener('resize', function () {
      initCascade();
      if (reducedMotion) renderFrame(0);
    }, { passive: true });

    if ('IntersectionObserver' in window && heroSec && !reducedMotion) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var nowVis = entry.isIntersecting;
          if (nowVis && !visible) {
            visible = true;
            rafId = window.requestAnimationFrame(renderFrame);
          } else if (!nowVis && visible) {
            visible = false;
            if (rafId) window.cancelAnimationFrame(rafId);
          }
        });
      }, { threshold: 0.02 });
      io.observe(heroSec);
    }
  })();
</script>

</Layout>
