---
import Layout from '../layouts/Layout.astro';
import RegisterSwitcher from '../components/RegisterSwitcher.astro';
import AvalancheGravityWell from '../components/AvalancheGravityWell.astro';
import NineRungRatchet from '../components/NineRungRatchet.astro';
import AvalancheFilmEmbed from '../components/AvalancheFilmEmbed.astro';
import ForcingSimulator from '../components/ForcingSimulator.astro';
import ForecastTable from '../components/ForecastTable.astro';
import PlanetaryWellObservatory from '../components/PlanetaryWellObservatory.astro';
import { BIO_MODELS, AI_WINTER_DIAGNOSES, TRANSLATION_MATRIX, TEN_CAMPS } from '../data/science';
import { LEARNING_MODALITIES, SISTER_REFERENCES } from '../data/ecosystem';
---

<Layout title="An Educational Guide to the 9-Rung Computer Intelligence Avalanche & Compilation Threshold">

<!-- ═══ FULL-VIEWPORT LIVING HERO (VERY TOP) ═══ -->
<section
  id="hero"
  class="min-h-[86vh] -mt-14 pt-32 pb-28 md:pt-44 md:pb-40 flex items-center justify-center relative overflow-hidden px-6"
>
  <!-- Luminous Dual-Phase Aurora Orbs -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="aurora-breathe absolute -top-20 left-[14%] w-[560px] h-[560px] rounded-full bg-brand-amber/[0.085] blur-[140px]"></div>
    <div class="aurora-breathe-slow absolute bottom-0 right-[12%] w-[640px] h-[640px] rounded-full bg-brand-cyan/[0.095] blur-[150px]"></div>
  </div>

  <!-- 60fps 2D Canvas: "Living Crystallization Cascade" -->
  <canvas
    id="avalanche-hero-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none z-0"
    aria-hidden="true"
  ></canvas>

  <!-- Soft center vignette for crystal-clear typography -->
  <div
    class="absolute inset-0 pointer-events-none z-[1]"
    style="background: radial-gradient(ellipse 54% 48% at 50% 50%, color-mix(in srgb, var(--color-brand-dark) 62%, transparent) 0%, transparent 100%);"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 max-w-4xl mx-auto w-full text-center flex flex-col items-center">
    <!-- Minimal Phase-Transition Emblem -->
    <div class="mb-7" aria-hidden="true">
      <svg width="210" height="64" viewBox="0 0 240 74" fill="none" class="select-none float">
        <g stroke="#F59E0B" stroke-width="1.2" opacity="0.72">
          <circle cx="32" cy="48" r="3.5" fill="#F59E0B" />
          <circle cx="60" cy="41" r="3.5" fill="#F59E0B" />
          <circle cx="88" cy="34" r="4" fill="#EA580C" />
          <path d="M 32,48 L 60,41 L 88,34 L 116,34" stroke-dasharray="3 3" />
        </g>
        <line x1="120" y1="8" x2="120" y2="62" stroke="#FFFFFF" stroke-width="1.1" stroke-dasharray="3 3" opacity="0.6" />
        <circle cx="120" cy="34" r="5.5" fill="#00D4AA" />
        <circle cx="120" cy="34" r="11" stroke="#00D4AA" stroke-width="0.9" opacity="0.4" />
        <g stroke="#00D4AA" stroke-width="1.4">
          <path d="M 124,34 L 156,26 L 186,19 L 214,14" />
          <rect x="152" y="22" width="7.5" height="7.5" rx="1.5" fill="#00D4AA" />
          <rect x="182" y="15" width="7.5" height="7.5" rx="1.5" fill="#00D4AA" />
          <rect x="210" y="10" width="8.5" height="8.5" rx="1.5" fill="#10B981" />
        </g>
      </svg>
    </div>

    <p class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.16em] uppercase text-brand-amber bg-brand-amber/[0.08] border border-brand-amber/25 px-4 py-1.5 rounded-full mb-8">
      <span>Evolutionary Ratchets &middot; Compilation Threshold</span>
    </p>

    <h1 class="font-display text-[clamp(38px,6.2vw,76px)] font-bold text-brand-white mb-8 tracking-tight leading-[1.02]">
      Intelligence cannot scale ecologically <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-amber via-brand-cyan to-brand-emerald">until it compiles.</span>
    </h1>

    <p class="font-body text-brand-slate text-[clamp(17px,2vw,21px)] max-w-2xl mx-auto leading-relaxed mb-12">
      Across 3.8 billion years of biology and 76 years of computing, solving recurring problems from scratch wastes energy and compounds noise. Crossing <strong class="text-brand-white font-semibold">The Compilation Threshold</strong> freezes verified discoveries into microjoule lookup reflexes.
    </p>

    <!-- 2 Clean CTAs -->
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="#rungs"
        class="inline-flex items-center gap-2 font-mono text-sm text-brand-dark bg-brand-cyan px-8 py-3.5 rounded-full no-underline hover:bg-brand-teal transition-all font-semibold shadow-[0_10px_30px_-8px_rgba(0,212,170,0.45)]"
      >
        <span>Explore the 9 Rungs &darr;</span>
      </a>
      <a
        href="#watch-and-listen"
        data-av-jump-15s
        class="inline-flex items-center gap-2 font-mono text-sm text-brand-light bg-brand-white/[0.03] backdrop-blur-md border border-brand-border px-8 py-3.5 rounded-full no-underline hover:border-brand-amber/55 hover:text-brand-amber transition-all"
      >
        <span class="text-brand-amber" aria-hidden="true">&#9654;</span>
        <span>Watch 15s Explainer</span>
      </a>
    </div>
  </div>
</section>

<hr class="section-divider" aria-hidden="true" />

<!-- ═══ GRAVITY WELL (CALMLY BELOW THE HERO) ═══ -->
<AvalancheGravityWell />

<hr class="section-divider" aria-hidden="true" />

<!-- ═══ SPACIOUS KEY MILESTONES (#mission / #highlights) ═══ -->
<section id="mission" class="py-32 md:py-40 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-20" data-reveal>
      <p class="section-label-cyan mb-4">Empirical &amp; Formal Anchor Points</p>
      <h2 class="font-display text-3xl sm:text-5xl font-bold text-brand-white tracking-tight mb-5">
        Measured in joules. Checked by machine.
      </h2>
      <p class="font-body text-lg text-brand-slate max-w-2xl mx-auto leading-relaxed">
        Four independently checkable benchmarks separating exploratory neural heat from compiled deterministic competence.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8" data-reveal>
      <div class="glass-card spotlight-card p-9 md:p-10 flex flex-col justify-between">
        <div>
          <span class="ev-badge ev-theorem mb-4">Lean 4.36.0 [T]</span>
          <div class="font-display text-4xl md:text-[44px] font-bold text-brand-white tracking-tight mb-2">132</div>
          <div class="font-display text-base font-semibold text-brand-cyan mb-2">Formal Theorems</div>
          <p class="font-body text-sm text-brand-slate leading-relaxed m-0">
            Zero-axiom proofs across 6 kernels establishing monotone ratchet progress and soundness gates.
          </p>
        </div>
        <p class="gw-non-plain-detail reg-scientist font-mono text-[11px] text-brand-gray leading-relaxed mt-4 pt-4 border-t border-brand-border">
          45 CTA + 36 LUT6 + 20 Codon + 31 Horizon + 5,393 RCE constants (@ f87d6af2; 0 sorry).
        </p>
      </div>

      <div class="glass-card spotlight-card p-9 md:p-10 flex flex-col justify-between">
        <div>
          <span class="ev-badge ev-measured mb-4">INA3221 measured_j</span>
          <div class="font-display text-4xl md:text-[44px] font-bold text-brand-white tracking-tight mb-2">98 / 100</div>
          <div class="font-display text-base font-semibold text-brand-cyan mb-2">10-Paradigm Synthesis</div>
          <p class="font-body text-sm text-brand-slate leading-relaxed m-0">
            Coupling ten AI paradigms via sub-millijoule gates breaks the &le;49% isolated single-camp ceiling.
          </p>
        </div>
        <p class="gw-non-plain-detail reg-scientist font-mono text-[11px] text-brand-gray leading-relaxed mt-4 pt-4 border-t border-brand-border">
          9.26&times;&ndash;26.87&times; higher Tegra INA3221 measured_j CpJ (CTA-E5).
        </p>
      </div>

      <div class="glass-card spotlight-card p-9 md:p-10 flex flex-col justify-between">
        <div>
          <span class="ev-badge ev-measured mb-4">KV260 &amp; Thor</span>
          <div class="font-display text-4xl md:text-[44px] font-bold text-brand-amber tracking-tight mb-2">26.58&times;</div>
          <div class="font-display text-base font-semibold text-brand-white mb-2">Cascade Shunt Cut</div>
          <p class="font-body text-sm text-brand-slate leading-relaxed m-0">
            Board-shunt energy reduction from the 4-Stage Lookup-First Cascade on AMD Kria KV260.
          </p>
        </div>
        <p class="gw-non-plain-detail reg-scientist font-mono text-[11px] text-brand-gray leading-relaxed mt-4 pt-4 border-t border-brand-border">
          685.43 &micro;J gross (40.49 &micro;J net) KV260 INA260; 927.30 &micro;J 1 KiB WAI1 verify.
        </p>
      </div>

      <div class="glass-card spotlight-card p-9 md:p-10 flex flex-col justify-between">
        <div>
          <span class="ev-badge ev-reported mb-4">C(z) = 1 Gate</span>
          <div class="font-display text-4xl md:text-[44px] font-bold text-brand-emerald tracking-tight mb-2">0 / 400</div>
          <div class="font-display text-base font-semibold text-brand-white mb-2">Cross-ISA Drift</div>
          <p class="font-body text-sm text-brand-slate leading-relaxed m-0">
            Bit-exact execution parity across ARMv9, ARMv8, Core i9, and Ryzen 395 substrates.
          </p>
        </div>
        <p class="gw-non-plain-detail reg-scientist font-mono text-[11px] text-brand-gray leading-relaxed mt-4 pt-4 border-t border-brand-border">
          Digest a541323b&hellip;46f0 (95% CP &le; 0.00746); 0/60 broken commits in CTA-E2.
        </p>
      </div>
    </div>
  </div>
</section>

<hr class="section-divider" aria-hidden="true" />

<!-- ═══ SECTION I (#rungs): THE 9-RUNG COMPUTER INTELLIGENCE AVALANCHE ═══ -->
<section id="rungs" class="max-w-6xl mx-auto px-6 py-32 md:py-44 scroll-mt-24">
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16" data-reveal>
    <div class="max-w-3xl space-y-5">
      <p class="section-label">Chapter I &middot; The 9-Rung Computer Intelligence Avalanche</p>
      <h2 class="font-display text-3xl sm:text-5xl font-bold text-brand-white tracking-tight leading-[1.08]">
        Why stateless tool loops stall at <span class="text-brand-rose">Rung 5</span> &mdash; and how compilation unlocks <span class="text-brand-cyan">Rungs 6&ndash;9</span>.
      </h2>
      <p class="reg-visionary font-body text-brand-slate text-base md:text-lg leading-relaxed">
        Rungs 1 through 5 (Search, Generation, Reasoning, Communication, Tool Use) expanded what single-turn inference can do, yet remain stateless: each session wakes cold, re-pays full floating-point compute on familiar patterns, and compounds errors across prose handoffs. Crossing <strong class="text-brand-white">The Compilation Threshold</strong> converts verified experience into persistent low-energy substrates.
      </p>
      <p class="reg-scientist font-mono text-xs sm:text-sm text-brand-light leading-relaxed">
        Formalized across <code class="code-chip">Avalanche/QuorumRatchet.lean</code>, <code class="code-chip">EnzymaticSynthesis.lean</code>, and <code class="code-chip">LutAdapt/Cascade.lean</code>: Phase 1 operates at &Delta;T &approx; 1 &le; &Delta;T*; Phase 2 satisfies &Delta;T &gt; E_compile / (p₀&prime;(c_wake &minus; c₀)) with C(z) = 1.
      </p>
    </div>
    <div class="flex flex-col sm:flex-row lg:flex-col items-start lg:items-end gap-3 shrink-0">
      <RegisterSwitcher label="Explanation Mode" />
      <a href="/rungs" class="inline-flex items-center gap-2 font-mono text-xs text-brand-amber border border-brand-amber/35 px-4 py-2.5 rounded-full no-underline hover:bg-brand-amber/10 transition-colors">
        Full /rungs Chapter &rarr;
      </a>
    </div>
  </div>

  <NineRungRatchet />

  <!-- Spacious Deep-Dive Callout: Atomic LUT6 (u64) 64-Codon Basis -->
  <div class="mt-16 glass-card spotlight-card p-8 md:p-12 border-brand-cyan/30 space-y-6" data-reveal>
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <p class="section-label-cyan">Deep-Dive Module &middot; 4&sup3; = 64 Codons &harr; 2&sup6; = 64-Bit LUT6</p>
        <h3 class="font-display text-2xl md:text-3xl font-bold text-brand-white tracking-tight">
          Why <code class="code-chip">LUT6</code> (<code class="code-chip">u64</code>) Is the Atomic 64-Codon Basis
        </h3>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a href="/rungs#lut6-basis" class="inline-flex items-center gap-1.5 font-mono text-xs text-brand-dark bg-brand-cyan px-5 py-2.5 rounded-full no-underline hover:bg-brand-teal transition-colors font-semibold">
          Walsh-Hadamard Inspector &rarr;
        </a>
        <a href="/rungs#hybrid-means-test" class="inline-flex items-center gap-1.5 font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-full no-underline hover:bg-brand-amber/10 transition-colors">
          4-Tier Hardware Test &rarr;
        </a>
      </div>
    </div>

    <div class="reg-pair">
      <p class="reg-visionary font-body text-sm md:text-base text-brand-light leading-relaxed m-0">
        Biology (<strong class="text-brand-white">4&sup3; = 64</strong> nucleotide codons) and reconfigurable digital logic (<strong class="text-brand-cyan">2&sup6; = 64</strong> truth-table bits in one <code class="code-chip">u64</code> mask) converge on a discrete, local, functionally complete basis rather than an entangled floating-point weight soup &mdash; allowing a <strong class="text-brand-emerald">16 KB <code class="code-chip">#![no_std]</code> Rust nucleus</strong> to execute identically from a $4 microcontroller up to FPGAs.
      </p>
      <div class="reg-scientist font-mono text-xs text-brand-light bg-brand-dark/60 p-4 rounded-xl border border-brand-border space-y-2">
        <div class="text-brand-cyan">1-Hot Memorization: &Sigma;<sub>|S|&ge;5</sub> E<sub>norm</sub>(S) = 448 / 4096 (7/64) &rarr; Rejected by FWHT Gate</div>
        <div class="text-brand-emerald">2-Bit Wobble (0xF &lt;&lt; (target &amp; 0x3C)): &Sigma;<sub>|S|&ge;5</sub> E<sub>norm</sub>(S) = 0 / 4096 &middot; 87.0% Wake Suppression &middot; 176 nJ Thor measured_j</div>
      </div>
    </div>
  </div>
</section>

<hr class="section-divider" aria-hidden="true" />

<!-- ═══ TELESCOPING EXPLAINER FILMS & RADIO DESK ═══ -->
<AvalancheFilmEmbed />

<hr class="section-divider" aria-hidden="true" />

<!-- ═══ PLANETARY DIGITAL WELL (CLEAN SUMMARY IN PLAIN MODE · LIVE OBSERVATORY AT DEPTH 2+) ═══ -->
<section id="planetary-well" class="max-w-6xl mx-auto px-6 py-28 md:py-36">
  <div class="gw-plain-whisper glass-card spotlight-card p-8 md:p-12 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
    <div class="space-y-3 max-w-2xl">
      <p class="section-label-cyan">Live 6-Stratum Commons &middot; 1,315 Lowering Recipes</p>
      <h2 class="font-display text-2xl sm:text-4xl font-bold text-brand-white tracking-tight">
        The Planetary Digital Well
      </h2>
      <p class="font-body text-base text-brand-slate leading-relaxed m-0">
        Explore 1,315 codified open-source compilers, provers, databases, and 64 developer staples mapped with explicit Stage 4 &rarr; 1 compilation recipes. Tucked away in Plain mode to keep this guide airy.
      </p>
    </div>
    <div class="flex flex-wrap gap-3 shrink-0">
      <a href="/planetary" class="font-mono text-xs bg-brand-cyan text-brand-dark font-semibold px-6 py-3 rounded-full no-underline hover:bg-brand-teal transition-all">
        Open /planetary Observatory &rarr;
      </a>
      <button
        type="button"
        data-gw-jump-depth="visual"
        class="font-mono text-xs text-brand-cyan border border-brand-cyan/40 bg-brand-cyan/10 px-5 py-3 rounded-full cursor-pointer hover:bg-brand-cyan/20 transition-all"
      >
        Expand Inline (2 &middot; Visual)
      </button>
    </div>
  </div>

  <details data-gw-min-depth="visual" class="gw-altitude-details">
    <summary class="sr-only">Planetary Digital Well Interactive Observatory</summary>
    <PlanetaryWellObservatory compact={true} />
  </details>
</section>

<hr class="section-divider" aria-hidden="true" />

<!-- ═══ DEPTH 4 · FULL TECHNICAL SPEC PROGRESSIVE FOLD ═══ -->
<div class="gw-formal-fold max-w-6xl mx-auto px-6 my-24 md:my-32">
  <div class="glass-card spotlight-card p-8 md:p-10 border border-brand-border">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl min-w-0">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-brand-cyan font-semibold">
          Depth 4 &middot; Full Technical Specification
        </div>
        <h2 class="font-display text-xl md:text-2xl font-bold text-brand-white m-0">
          Conserved Ratchet Operator Equations, DES-10 Benchmark Matrix &amp; 18 Falsifiable Forecasts
        </h2>
        <p class="font-body text-sm text-brand-slate leading-relaxed m-0">
          Folded by default at Depths 1&ndash;3 so the ice-track intuition and 9-Rung explorer breathe. Unfolds automatically at Depth 4 or whenever you jump to <a href="#science" class="text-brand-cyan no-underline hover:underline">#science</a>, <a href="#forcing" class="text-brand-cyan no-underline hover:underline">#forcing</a>, or <a href="#forecast" class="text-brand-cyan no-underline hover:underline">#forecast</a>.
        </p>
      </div>
      <button
        type="button"
        data-gw-fold-toggle
        aria-expanded="false"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border border-brand-cyan/40 bg-brand-cyan/10 font-mono text-xs text-brand-cyan font-semibold hover:bg-brand-cyan/20 cursor-pointer transition-all shrink-0"
      >
        <span data-gw-fold-label>Expand Full Spec &#9662;</span>
      </button>
    </div>
  </div>

  <div class="gw-formal-fold-body pt-12">

    <!-- ═══ SECTION II (#science): WHAT AN EVOLUTIONARY / COMPUTATIONAL RATCHET IS ═══ -->
    <section id="science" class="max-w-6xl mx-auto px-2 py-28 md:py-36 scroll-mt-24 space-y-16">
      <div class="max-w-4xl" data-reveal>
        <p class="section-label-cyan mb-3">Chapter II &middot; What a Ratchet Is (3.8 Gyr Biology CL01–CL24 + 76 Years AI AI01–AI38)</p>
        <h2 class="font-display text-3xl sm:text-5xl font-bold text-brand-white tracking-tight">
          One three-phase operator connects <span class="text-brand-amber">living cells</span>, <span class="text-brand-cyan">human culture</span>, and <span class="text-brand-emerald">digital verification</span>.
        </h2>
        <p class="reg-visionary font-body text-brand-slate text-base md:text-lg leading-relaxed mt-5">
          In mechanical engineering and evolutionary biology, a <strong class="text-brand-white">ratchet</strong> permits forward motion while preventing backward slip. Across 3.8 billion years of living systems (<code class="code-chip">CL01–CL24</code>) and 76 years of AI (<code class="code-chip">AI01–AI38</code>), major jumps in collective capability arose from pairing an <strong class="text-brand-white">externalized signal</strong> with a <strong class="text-brand-cyan">selective threshold and verification gate</strong>.
        </p>
      </div>

      <!-- Conserved Operator + CpJ Equations & Fig 02 SVG -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch" data-reveal>
        <div class="lg:col-span-5 eq-block flex flex-col justify-center space-y-6">
          <div>
            <div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-brand-cyan mb-2 text-center">Conserved Avalanche Cycle Operator ([T])</div>
            <p class="eq">
              <span class="tuple">𝒞 = 𝒯 &compfn; 𝒢<sub>&theta;</sub> &compfn; ℰ</span>
            </p>
            <p class="font-mono text-xs text-brand-slate text-center leading-relaxed mt-2">
              <span class="text-brand-amber">ℰ Externalize</span> (s<sub>i</sub> &rarr; m &isin; ℳ) &rarr;
              <span class="text-brand-cyan">𝒢<sub>&theta;</sub> Threshold &amp; Gate</span> (&Sigma; w<sub>kj</sub> 𝕀[V<sub>j</sub>(m<sub>k</sub>)=1] &ge; &theta;<sub>j</sub>) &rarr;
              <span class="text-brand-emerald">𝒯 Non-Regressing Ratchet</span> (Q(t+1) &ge; Q(t))
            </p>
          </div>
          <div class="pt-5 border-t border-brand-border">
            <div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-brand-amber mb-2 text-center">Cross-Substrate Efficiency Metric</div>
            <p class="eq">
              <span class="amber">CpJ</span> <span class="op">=</span> <span class="tuple">Q / (E<sub>compute</sub> + E<sub>comm</sub> + E<sub>idle</sub>)</span>
            </p>
            <p class="eq-caption">Verified Coherence Units per Joule &middot; CTA-T1..T23</p>
          </div>
        </div>

        <figure class="lg:col-span-7 glass-card p-6 md:p-8 flex flex-col justify-between m-0">
          <svg
            viewBox="0 0 680 250"
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-auto"
            role="img"
            aria-label="Fig 02: Conserved 3-phase operator Externalize E, Threshold and Gate Ingest G_theta, and Non-Regressing Ratchet T contrasted against unverified k-hop decay f^k."
          >
            <rect width="680" height="250" rx="8" fill="var(--svg-bg)" />
            <text x="24" y="28" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="0.16em" fill="#00D4AA">FIG. 02 &middot; ANATOMY OF THE THREE-PHASE EXTERNALIZATION RATCHET</text>

            <g transform="translate(24, 52)">
              <rect width="186" height="122" rx="8" fill="var(--svg-panel)" stroke="#F59E0B" stroke-width="1.3" />
              <text x="14" y="24" font-family="JetBrains Mono, monospace" font-size="10.5" font-weight="700" fill="#F59E0B">1 &middot; EXTERNALIZE (ℰ)</text>
              <text x="14" y="46" font-family="Inter, sans-serif" font-size="11.5" fill="var(--svg-text)">Bounded tracer packet</text>
              <text x="14" y="66" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--svg-muted)">&bull; Bio: AHL / EV / cAMP</text>
              <text x="14" y="83" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--svg-muted)">&bull; Culture: Print / Git</text>
              <text x="14" y="100" font-family="JetBrains Mono, monospace" font-size="9.5" fill="#F59E0B">&bull; Digital: &Phi;_IR binary frame</text>
            </g>

