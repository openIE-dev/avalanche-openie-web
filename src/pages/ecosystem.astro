---
import Layout from '../layouts/Layout.astro';
import RegisterSwitcher from '../components/RegisterSwitcher.astro';
import { LEARNING_MODALITIES, SISTER_REFERENCES } from '../data/ecosystem';
---

<Layout
  title="Open Educational Resources, Primary Papers, Interactive Labs & Media"
  description="Guide to open educational resources accompanying OpenIE Avalanche: primary research papers, pre-registered datasets, interactive browser labs, Research TV visual explainers, Research Radio, and sister Periodic-Stack reference texts."
>

<div class="max-w-7xl mx-auto px-6 py-16 space-y-20">
  <!-- Header -->
  <header class="space-y-5 border-b border-brand-border pb-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="font-mono text-xs text-brand-cyan no-underline hover:underline">&larr; Back to Avalanche Observatory</a>
      <RegisterSwitcher label="Explanation Mode" />
    </div>
    <p class="section-label">Open Educational Resources &amp; Further Study</p>
    <h1 class="font-display text-4xl sm:text-6xl font-bold text-brand-white tracking-tight">
      Papers, Interactive Labs, TV, Radio &amp; Sister Reference Maps
    </h1>
    <p class="font-body text-brand-slate text-base md:text-lg max-w-4xl leading-relaxed">
      <code class="code-chip">avalanche.openie.dev</code> is designed as a self-contained study guide. Every concept, theorem, biophysical model, and hardware measurement connects directly to open-access monographs, interactive browser laboratories, short visual films, audio discussions, and sister subject references.
    </p>
  </header>

  <!-- SVG Curriculum Map -->
  <figure class="glass-card p-5 md:p-8">
    <svg
      viewBox="0 0 1060 300"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto"
      role="img"
      aria-label="Study map connecting Avalanche conceptual guide to primary research papers, interactive living laboratories, TV and Radio explainers, and sister Periodic-Stack reference texts."
    >
      <rect width="1060" height="300" rx="10" fill="var(--svg-bg)" />
      <text x="34" y="34" font-family="JetBrains Mono, monospace" font-size="10.5" letter-spacing="0.18em" fill="#00D4AA">OPEN STUDY ARCHITECTURE &middot; HOW THE EDUCATIONAL RESOURCES CONNECT</text>

      <!-- Center Hub -->
      <g transform="translate(410, 92)">
        <rect width="240" height="120" rx="10" fill="var(--svg-panel)" stroke="#00D4AA" stroke-width="1.8" />
        <text x="120" y="34" font-family="JetBrains Mono, monospace" font-size="10" fill="#F59E0B" text-anchor="middle">CONCEPTUAL STUDY HUB</text>
        <text x="120" y="60" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="700" fill="var(--svg-text)" text-anchor="middle">avalanche.openie.dev</text>
        <text x="120" y="82" font-family="Inter, sans-serif" font-size="11.5" fill="var(--svg-muted)" text-anchor="middle">9 Rungs &middot; Ratchet Law &middot; Simulator</text>
        <text x="120" y="100" font-family="JetBrains Mono, monospace" font-size="9.5" fill="#00D4AA" text-anchor="middle">Plain Language &harr; Formal Science</text>
      </g>

      <!-- Left: Primary Papers & Proofs -->
      <g transform="translate(34, 62)">
        <rect width="290" height="82" rx="8" fill="var(--svg-panel)" stroke="rgba(0,212,170,0.4)" stroke-width="1.2" />
        <text x="16" y="24" font-family="JetBrains Mono, monospace" font-size="10" fill="#00D4AA">PRIMARY RESEARCH PAPERS</text>
        <text x="16" y="45" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="700" fill="var(--svg-text)">research.openie.dev/papers/</text>
        <text x="16" y="65" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--svg-muted)">HTML + PDF + LaTeX + 6-Kernel Lean</text>
      </g>

      <g transform="translate(34, 162)">
        <rect width="290" height="82" rx="8" fill="var(--svg-panel)" stroke="rgba(245,158,11,0.4)" stroke-width="1.2" />
        <text x="16" y="24" font-family="JetBrains Mono, monospace" font-size="10" fill="#F59E0B">LIVING LABS &amp; TUTORIALS</text>
        <text x="16" y="45" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="700" fill="var(--svg-text)">/living/ &amp; /tutorials/ (Labs 1–5)</text>
        <text x="16" y="65" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--svg-muted)">Interactive simulations in browser</text>
      </g>

      <!-- Right: TV/Radio & Sister References -->
      <g transform="translate(736, 62)">
        <rect width="290" height="82" rx="8" fill="var(--svg-panel)" stroke="rgba(245,158,11,0.4)" stroke-width="1.2" />
        <text x="16" y="24" font-family="JetBrains Mono, monospace" font-size="10" fill="#F59E0B">AUDIOVISUAL EXPLAINERS</text>
        <text x="16" y="45" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="700" fill="var(--svg-text)">Research TV &amp; Research Radio</text>
        <text x="16" y="65" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--svg-muted)">5s–90s visual films &amp; audio desks</text>
      </g>

      <g transform="translate(736, 162)">
        <rect width="290" height="82" rx="8" fill="var(--svg-panel)" stroke="rgba(0,212,170,0.4)" stroke-width="1.2" />
        <text x="16" y="24" font-family="JetBrains Mono, monospace" font-size="10" fill="#00D4AA">SISTER TEACHING REFERENCES</text>
        <text x="16" y="45" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="700" fill="var(--svg-text)">stack / compute / proof / memory</text>
        <text x="16" y="65" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--svg-muted)">Deep-dive domain monographs</text>
      </g>

      <!-- Connecting lines -->
      <g stroke="#00D4AA" stroke-width="1.4" stroke-dasharray="4 4" class="anim-flow">
        <line x1="324" y1="103" x2="410" y2="132" />
        <line x1="324" y1="203" x2="410" y2="172" />
        <line x1="650" y1="132" x2="736" y2="103" />
        <line x1="650" y1="172" x2="736" y2="203" />
      </g>
    </svg>
  </figure>

  <!-- Learning Modalities -->
  <section class="space-y-6">
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-brand-white">
      I &middot; Primary Papers, Interactive Labs, &amp; Audiovisual Explainers
    </h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      {LEARNING_MODALITIES.map((m) => (
        <div class="glass-card p-6 flex flex-col justify-between space-y-4">
          <div class="space-y-2.5">
            <div class="flex items-center justify-between font-mono text-[10.5px] uppercase tracking-wider">
              <span class="text-brand-cyan font-bold">{m.kind}</span>
              <span class="text-brand-gray">{m.scope}</span>
            </div>
            <a href={m.url} class="block font-display text-xl font-bold text-brand-white hover:text-brand-cyan no-underline">
              {m.title} &nearr;
            </a>
            <p class="font-body text-sm text-brand-slate leading-relaxed">{m.description}</p>
          </div>
          <ul class="space-y-1.5 pt-3 border-t border-brand-border font-mono text-[11px] text-brand-light">
            {m.highlights.map((h) => (
              <li class="flex items-start gap-2">
                <span class="text-brand-amber">&bull;</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Direct Paper Reading List -->
    <div class="glass-card p-6 space-y-4">
      <div class="font-mono text-xs uppercase tracking-wider text-brand-amber font-semibold">Core Open-Access Reading List on research.openie.dev</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <a href="https://research.openie.dev/papers/communication-avalanche/" class="p-4 rounded-lg bg-brand-dark/50 border border-brand-border no-underline hover:border-brand-cyan transition-colors block">
          <div class="font-display text-sm font-bold text-brand-white">The Communication Tool Avalanche</div>
          <p class="font-body text-brand-slate mt-1">3.8 Gyr biological ladder (CL01–CL24), 1950–2026 AI audit (AI01–AI38), 45 Lean 4.36.0 theorems, 5-host hardware audit (Jetson Thor INA3221 measured_j), and DES-10.</p>
        </a>
        <a href="https://research.openie.dev/papers/lut-adapt/" class="p-4 rounded-lg bg-brand-dark/50 border border-brand-border no-underline hover:border-brand-cyan transition-colors block">
          <div class="font-display text-sm font-bold text-brand-white">Downward LUT6 Compilation in a Mixture of Limits Cascade</div>
          <p class="font-body text-brand-slate mt-1">Proposition 1 amortization, 512&times;512 Beneš–Copy–Beneš + 81 &times; RAMB36E2 LUT6 RTL, Conformal ACI, and Expert-AirMoL Sparse-MoE NVMe streaming (27 Lean theorems).</p>
        </a>
        <a href="https://research.openie.dev/papers/deterministic-null/" class="p-4 rounded-lg bg-brand-dark/50 border border-brand-border no-underline hover:border-brand-cyan transition-colors block">
          <div class="font-display text-sm font-bold text-brand-white">Deterministic Null (Shape D DNULLMM1)</div>
          <p class="font-body text-brand-slate mt-1">Pre-registered zero-model 64-bit integer case control (OpenTimestamps + drand) across 4,030 post-beacon instances (1.77 &micro;J POSIX mmap lookup).</p>
        </a>
        <a href="https://research.openie.dev/papers/rce-compile/" class="p-4 rounded-lg bg-brand-dark/50 border border-brand-border no-underline hover:border-brand-cyan transition-colors block">
          <div class="font-display text-sm font-bold text-brand-white">RCE Compile &amp; RCE-JEPA</div>
          <p class="font-body text-brand-slate mt-1">Law of Compilation tested across 12 compiler families, positional De Bruijn hashing (0 / 500 mutant collisions), librce_rt.rlib (N* = 1,079), and FormEBM-v3 (0.9437 AUROC).</p>
        </a>
      </div>
    </div>

    <!-- Open Third-Party Replication & Falsification Callout -->
    <div class="glass-card spotlight-card p-6 md:p-7 border-brand-emerald/35 bg-brand-emerald/[0.04] flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="space-y-2 max-w-3xl">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-brand-emerald font-semibold">
          Independent Lab &amp; Hobbyist Bench &middot; Open Replication Protocol
        </div>
        <h3 class="font-display text-xl sm:text-2xl font-bold text-brand-white">
          Run and Falsify the Avalanche Ladder Independently in Four Steps
        </h3>
        <p class="font-body text-xs sm:text-sm text-brand-slate leading-relaxed">
          External laboratories, university courses, and embedded systems hobbyists can independently audit all 123 six-kernel <code class="code-chip">Lean 4.36.0</code> proofs inside <code class="code-chip">bubblewrap</code>, synthesize 4 KB <code class="code-chip">#![no_std] lut6-core</code> crystals with <code class="code-chip">Yosys -lut 6</code>, and meter real physical nanojoules/microjoules using a $4 <code class="code-chip">RP2040</code>, <code class="code-chip">Alif E3/E4</code>, or <code class="code-chip">KV260</code> paired with an inline <code class="code-chip">PPK2</code> / <code class="code-chip">INA228</code> GPIO-framed shunt.
        </p>
      </div>
      <div class="flex flex-wrap gap-2.5 shrink-0">
        <a href="/forecast#replicate" class="inline-flex items-center gap-1.5 font-mono text-xs text-brand-dark bg-brand-emerald px-4 py-2.5 rounded-lg no-underline hover:bg-brand-cyan transition-colors font-semibold">
          Open 4-Step Replication Checklist &rarr;
        </a>
        <a href="/rungs#lut6-basis" class="inline-flex items-center gap-1.5 font-mono text-xs text-brand-cyan border border-brand-cyan/40 px-3.5 py-2.5 rounded-lg no-underline hover:bg-brand-cyan/10 transition-colors">
          Inspect 16 KB lut6-core Basis &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Sister Periodic-Stack Educational Reference Directory -->
  <section class="space-y-6">
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-brand-white">
      II &middot; Sister Periodic-Stack Subject Reference Texts
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {SISTER_REFERENCES.map((s) => (
        <div class="glass-card p-5 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[10.5px] px-2 py-0.5 rounded border border-brand-cyan/35 bg-brand-cyan/10 text-brand-cyan font-semibold">
                {s.rungCoord}
              </span>
              <span class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">{s.topicArea}</span>
            </div>
            <a href={s.url} class="block font-display text-lg font-bold text-brand-white hover:text-brand-cyan no-underline">
              {s.name} <span class="font-mono text-xs font-normal text-brand-gray">({s.domain}) &nearr;</span>
            </a>
            {s.altDomain && s.altUrl && (
              <a href={s.altUrl} class="block font-mono text-[11px] text-brand-amber no-underline hover:underline">
                Mirror: {s.altDomain} &nearr;
              </a>
            )}
            <div class="reg-scientist font-mono text-[11px] text-brand-cyan bg-brand-dark/55 px-2.5 py-1.5 rounded border border-brand-border">
              {s.formalSignature}
            </div>
            <p class="font-body text-xs text-brand-slate leading-relaxed">{s.summary}</p>
          </div>
          <div class="pt-3 border-t border-brand-border flex items-center justify-between text-[11px] font-mono">
            <a href={s.tvUrl} class="text-brand-amber no-underline hover:underline">&#9654; Watch Explainer</a>
            <a href={s.radioUrl} class="text-brand-cyan no-underline hover:underline">&#9673; Audio Deep-Dive</a>
          </div>
        </div>
      ))}
    </div>
  </section>
</div>

</Layout>
