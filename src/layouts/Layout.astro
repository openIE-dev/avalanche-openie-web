---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import RegisterSwitcher from '../components/RegisterSwitcher.astro';
import GravityWellDepthBar from '../components/GravityWellDepthBar.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "OpenIE Avalanche — An open educational guide to evolutionary ratchets, the 9-Rung Computer Intelligence Avalanche, The Compilation Threshold, thermodynamic forcing functions, and falsifiable scientific forecasting."
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
---

<!DOCTYPE html>
<html lang="en" data-theme="dark" data-register="both">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00D4AA" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(pathname, 'https://avalanche.openie.dev').toString()} />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | OpenIE Avalanche</title>

    <meta property="og:title" content={`${title} | OpenIE Avalanche`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(pathname, 'https://avalanche.openie.dev').toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | OpenIE Avalanche`} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      (function(){
        var storedTheme = localStorage.getItem('oe-theme');
        var theme = storedTheme && ['dark','light','auto'].indexOf(storedTheme) !== -1 ? storedTheme : 'auto';
        if (theme === 'auto') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;

        var storedReg = localStorage.getItem('oe-avalanche-register');
        var reg = storedReg && ['both','visionary','scientist'].indexOf(storedReg) !== -1 ? storedReg : 'both';
        document.documentElement.setAttribute('data-register', reg);

        var allowedDepth = ['plain', 'visual', 'builder', 'formal'];
        var qDepth = '';
        try { qDepth = (new URLSearchParams(window.location.search).get('depth') || '').toLowerCase(); } catch (_e) {}
        var savedDepth = '';
        try { savedDepth = localStorage.getItem('oe-reading-depth') || ''; } catch (_e) {}
        var depth = allowedDepth.indexOf(qDepth) !== -1 ? qDepth : (allowedDepth.indexOf(savedDepth) !== -1 ? savedDepth : 'plain');
        if (allowedDepth.indexOf(qDepth) !== -1) {
          try { localStorage.setItem('oe-reading-depth', depth); } catch (_e) {}
        }
        document.documentElement.setAttribute('data-reading-depth', depth);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col noise-overlay grid-bg">
    <canvas id="particle-canvas"></canvas>

    <!-- Streamlined, Airy Top Navbar (4 primary links + Explore menu) -->
    <nav id="nav" aria-label="Main navigation" class="nav-glass fixed top-0 left-0 right-0 z-100 px-5 lg:px-10 py-3.5 flex justify-between items-center transition-all duration-300">
      <a href="/" aria-label="OpenIE Avalanche educational home" class="font-display text-[20px] lg:text-[22px] font-bold tracking-tight text-brand-white no-underline hover:no-underline shrink-0">
        Open<span class="text-brand-cyan">IE</span> <span class="text-brand-amber">Avalanche</span>
      </a>

      <button id="mobile-menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links" class="lg:hidden flex flex-col gap-1.5 p-2 text-brand-slate cursor-pointer bg-transparent border-none">
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-top"></span>
        <span class="block w-5 h-0.5 bg-current transition-opacity" id="burger-mid"></span>
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-bot"></span>
      </button>

      <div id="nav-links" class="hidden lg:flex lg:items-center gap-6 max-lg:fixed max-lg:inset-0 max-lg:top-[58px] max-lg:bg-brand-dark/96 max-lg:backdrop-blur-xl max-lg:flex-col max-lg:justify-center max-lg:gap-5 max-lg:z-50 max-lg:p-6">
        <a href="/#plain-story" class="font-body text-[13.5px] max-lg:text-lg font-medium text-brand-light no-underline hover:text-brand-cyan transition-colors">
          Start Here
        </a>
        <a href={isHome ? "/#rungs" : "/rungs"} class:list={["font-body text-[13.5px] max-lg:text-lg font-medium no-underline transition-colors", pathname.startsWith('/rungs') ? "text-brand-amber" : "text-brand-slate hover:text-brand-white"]}>
          The 9 Rungs
        </a>
        <a href="/planetary" class:list={["font-body text-[13.5px] max-lg:text-lg font-medium no-underline transition-colors", pathname.startsWith('/planetary') ? "text-brand-cyan" : "text-brand-slate hover:text-brand-cyan"]}>
          Planetary Well
        </a>
        <a href={isHome ? "/#forecast" : "/forecast"} class:list={["font-body text-[13.5px] max-lg:text-lg font-medium no-underline transition-colors", pathname.startsWith('/forecast') ? "text-brand-cyan" : "text-brand-slate hover:text-brand-white"]}>
          Forecast
        </a>

        <details class="relative nav-explore max-lg:text-center">
          <summary class="font-body text-[13.5px] max-lg:text-lg font-medium text-brand-slate hover:text-brand-white transition-colors cursor-pointer select-none inline-flex items-center gap-1">
            <span>Explore</span>
            <span class="text-[10px] opacity-70" aria-hidden="true">&#9662;</span>
          </summary>
          <div class="lg:absolute lg:right-0 lg:mt-3 lg:w-60 lg:rounded-2xl lg:border lg:border-brand-border lg:bg-brand-dark/95 lg:backdrop-blur-xl lg:p-2 lg:shadow-2xl max-lg:mt-3 max-lg:flex max-lg:flex-col max-lg:gap-2">
            <a href="/#science" class="block px-3.5 py-2 rounded-xl font-body text-[13px] text-brand-light no-underline hover:bg-brand-cyan/10 hover:text-brand-cyan transition-colors">Ratchet Science</a>
            <a href="/#forcing" class="block px-3.5 py-2 rounded-xl font-body text-[13px] text-brand-slate no-underline hover:bg-brand-cyan/10 hover:text-brand-white transition-colors">Forcing Simulator</a>
            <a href="/ecosystem" class="block px-3.5 py-2 rounded-xl font-body text-[13px] text-brand-slate no-underline hover:bg-brand-cyan/10 hover:text-brand-white transition-colors">Open Resources</a>
            <a href="https://research.openie.dev/living/compiled-agency/" class="block px-3.5 py-2 rounded-xl font-body text-[13px] text-brand-cyan no-underline hover:bg-brand-cyan/10 transition-colors">Compiled Agency Simulator &nearr;</a>
            <a href="https://research.openie.dev/tv/?channel=avalanche" class="block px-3.5 py-2 rounded-xl font-body text-[13px] text-brand-amber no-underline hover:bg-brand-amber/10 transition-colors">&#9654; Research TV (145) &nearr;</a>
            <a href="https://research.openie.dev/radio/?desk=avalanche" class="block px-3.5 py-2 rounded-xl font-body text-[13px] text-brand-slate no-underline hover:bg-brand-cyan/10 hover:text-brand-cyan transition-colors">&#9673; Research Radio (17) &nearr;</a>
            <a href="https://blog.openie.dev" class="block px-3.5 py-2 rounded-xl font-body text-[13px] text-brand-slate no-underline hover:bg-brand-amber/10 hover:text-brand-amber transition-colors">Chronicle (58) &nearr;</a>
          </div>
        </details>

        <div class="flex flex-wrap items-center justify-center gap-2.5 lg:ml-1 lg:pl-4 lg:border-l lg:border-brand-border">
          <RegisterSwitcher compact={true} label="Explanation Mode" />
          <button
            type="button"
            data-openie-live-trigger
            aria-label="Open 24 kHz Studio Live Voice Call and Video Mode (Cmd+Shift+V)"
            title="24 kHz Studio Live Voice & Video (⌘⇧V)"
            onclick="const e=event;setTimeout(()=>{if(!e.defaultPrevented&&!document.querySelector('body > [id*=&quot;openie&quot;],body > [class*=&quot;openie&quot;],[data-openie-dock]')){window.location.href='https://research.openie.dev/live/?surface=avalanche';}},60)"
            class="inline-flex items-center gap-1.5 font-mono text-[11px] text-brand-cyan border border-brand-cyan/35 bg-brand-cyan/10 px-3 py-1 rounded-full cursor-pointer hover:bg-brand-cyan/20 transition-all shrink-0"
          >
            <span aria-hidden="true">&#128222;</span> Live
          </button>
          <ThemeToggle />
        </div>
      </div>
    </nav>

    <main id="main" class="flex-1 pt-[56px] lg:pt-[62px] relative z-10">
      <GravityWellDepthBar />
      <slot />
    </main>

    <footer class="relative z-10 border-t border-brand-border px-6 md:px-10 py-16 md:py-20 mt-16" role="contentinfo">
      <div class="max-w-6xl mx-auto flex flex-col lg:flex-row justify-between items-start gap-12">
        <div class="max-w-xs">
          <div class="font-display text-base font-bold text-brand-white mb-3">
            Open<span class="text-brand-cyan">IE</span> <span class="text-brand-amber">Avalanche</span>
          </div>
          <p class="font-body text-[13px] text-brand-slate leading-relaxed mb-4">
            An open educational reference on evolutionary ratchets, the 9-Rung Computer Intelligence Avalanche, thermodynamic compilation thresholds, and falsifiable scientific forecasting.
          </p>
          <p class="font-mono text-[11px] text-brand-gray leading-relaxed">
            Zero trackers &middot; Self-hosted fonts &middot; Open science
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 md:gap-12 w-full lg:w-auto">
          <div>
            <div class="font-mono text-[10px] text-brand-amber tracking-[2px] uppercase mb-3">Study Guide</div>
            <div class="space-y-2">
              <a href="/" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-white transition-colors">Observatory Home</a>
              <a href="/rungs" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-amber transition-colors">The 9 Rungs &amp; Seminar Guide</a>
              <a href="/planetary" class="block font-body text-[12.5px] text-brand-cyan no-underline hover:text-brand-white transition-colors">The Planetary Digital Well</a>
              <a href="/forecast" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">1950–2026 History &amp; Forecast</a>
              <a href="/ecosystem" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Open Papers, Labs &amp; Media</a>
            </div>
          </div>

          <div>
            <div class="font-mono text-[10px] text-brand-cyan tracking-[2px] uppercase mb-3">Primary Research &amp; Labs</div>
            <div class="space-y-2">
              <a href="https://blog.openie.dev/posts/from-ephemeral-inference-to-compiled-agency/" class="block font-body text-[12.5px] text-brand-emerald font-medium no-underline hover:text-brand-white transition-colors">Capstone Position Essay</a>
              <a href="https://research.openie.dev/living/compiled-agency/" class="block font-body text-[12.5px] text-brand-cyan font-medium no-underline hover:text-brand-white transition-colors">Compiled Agency Simulator</a>
              <a href="https://blog.openie.dev" class="block font-body text-[12.5px] text-brand-amber no-underline hover:text-brand-gold transition-colors">Chronicle (58)</a>
              <a href="https://blog.openie.dev/verification/" class="block font-body text-[12.5px] text-brand-cyan no-underline hover:text-brand-white transition-colors">Verification &amp; Replicate</a>
              <a href="https://research.openie.dev/live/" class="block font-body text-[12.5px] text-brand-cyan no-underline hover:text-brand-white transition-colors">24 kHz Live S2S Studio</a>
              <a href="https://research.openie.dev/papers/communication-avalanche/" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Communication Avalanche Paper</a>
              <a href="https://research.openie.dev/papers/lut-adapt/" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Downward LUT6 Paper</a>
              <a href="https://research.openie.dev/tutorials/" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">14 Interactive Labs</a>
              <a href="https://research.openie.dev/tv/?channel=avalanche" class="block font-body text-[12.5px] text-brand-amber no-underline hover:text-brand-gold transition-colors">&#9654; Research TV (145 Films)</a>
              <a href="https://research.openie.dev/radio/?desk=avalanche" class="block font-body text-[12.5px] text-brand-cyan no-underline hover:text-brand-teal transition-colors">&#9673; Research Radio (17 Eps)</a>
            </div>
          </div>

          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Sister Teaching Maps</div>
            <div class="space-y-2">
              <a href="https://stack.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Periodic Stack Overview</a>
              <a href="https://compute.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Compute Reference</a>
              <a href="https://synthesis.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Synthesis Reference</a>
              <a href="https://knowledge.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Knowledge Reference</a>
              <a href="https://database.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Database &amp; Data</a>
              <a href="https://energy.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Energy Reference</a>
              <a href="https://state.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">State Reference</a>
              <a href="https://memory.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Memory Reference</a>
              <a href="https://communication.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Communication Reference</a>
              <a href="https://agent.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Agent Reference</a>
              <a href="https://proof.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Formal Proof Reference</a>
            </div>
          </div>

          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Open Access &amp; Legal</div>
            <div class="space-y-2">
              <a href="https://openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">openie.dev</a>
              <a href="https://research.openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">research.openie.dev</a>
              <a href="/llms.txt" class="block font-mono text-[11px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">llms.txt</a>
              <a href="mailto:contact@openie.dev" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Questions &amp; Errata</a>
              <a href="/terms" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Terms of Educational Use</a>
              <a href="/privacy" class="block font-body text-[12.5px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Privacy (Zero Tracking)</a>
            </div>
          </div>
        </div>
      </div>

      <div class="max-w-6xl mx-auto mt-12 pt-8 border-t border-brand-border flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <p class="font-body text-[11.5px] text-brand-gray">&copy; {new Date().getFullYear()} Open Interface Engineering &middot; Educational Monograph Series. Free to read, link, and cite with attribution.</p>
        <p class="font-mono text-[10.5px] text-brand-gray">Signed Provenance &middot; Self-Checked &middot; <span class="text-brand-cyan">measured_j</span> &perp; <span class="text-brand-indigo">reported_j</span> &perp; <span class="text-brand-amber">est_j</span> &perp; <span>unmetered</span></p>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const navLinks = document.getElementById('nav-links');
      const burgerTop = document.getElementById('burger-top');
      const burgerMid = document.getElementById('burger-mid');
      const burgerBot = document.getElementById('burger-bot');
      let menuOpen = false;

      // Close Explore dropdown on outside click or link click
      document.addEventListener('click', (e) => {
        document.querySelectorAll('details.nav-explore[open]').forEach((det) => {
          const target = e.target as Node | null;
          if (!target || !det.contains(target) || (target instanceof Element && target.closest('a'))) {
            det.removeAttribute('open');
          }
        });
      });

      menuBtn?.addEventListener('click', () => {
        menuOpen = !menuOpen;
        navLinks?.classList.toggle('hidden', !menuOpen);
        navLinks?.classList.toggle('flex', menuOpen);
        menuBtn.setAttribute('aria-expanded', String(menuOpen));
        menuBtn.setAttribute('aria-label', menuOpen ? 'Close menu' : 'Open menu');
        if (burgerTop) burgerTop.style.transform = menuOpen ? 'rotate(45deg) translate(3px, 3px)' : '';
        if (burgerMid) burgerMid.style.opacity = menuOpen ? '0' : '1';
        if (burgerBot) burgerBot.style.transform = menuOpen ? 'rotate(-45deg) translate(3px, -3px)' : '';
      });

      navLinks?.querySelectorAll('a, [data-openie-live-trigger]').forEach(a => {
        a.addEventListener('click', () => {
          if (menuOpen) {
            menuOpen = false;
            navLinks.classList.add('hidden');
            navLinks.classList.remove('flex');
            if (burgerTop) burgerTop.style.transform = '';
            if (burgerMid) burgerMid.style.opacity = '1';
            if (burgerBot) burgerBot.style.transform = '';
          }
        });
      });

      const nav = document.getElementById('nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      const REG_KEY = 'oe-avalanche-register';
      const validRegs = ['both', 'visionary', 'scientist'];

      function syncRegisterButtons(reg: string) {
        document.documentElement.setAttribute('data-register', reg);
        document.querySelectorAll<HTMLButtonElement>('[data-set-register]').forEach(btn => {
          const isMatch = btn.getAttribute('data-set-register') === reg;
          btn.setAttribute('data-active', String(isMatch));
          btn.setAttribute('aria-pressed', String(isMatch));
        });
      }

      const initialReg = localStorage.getItem(REG_KEY);
      syncRegisterButtons(initialReg && validRegs.includes(initialReg) ? initialReg : 'both');

      document.querySelectorAll<HTMLButtonElement>('[data-set-register]').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-set-register') || 'both';
          if (validRegs.includes(target)) {
            localStorage.setItem(REG_KEY, target);
            syncRegisterButtons(target);
            window.dispatchEvent(new CustomEvent('oe-register-change', { detail: { register: target } }));
          }
        });
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.06 });
      document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));

      document.querySelectorAll('.spotlight-card').forEach(card => {
        card.addEventListener('mousemove', (e: Event) => {
          const me = e as MouseEvent;
          const rect = (card as HTMLElement).getBoundingClientRect();
          (card as HTMLElement).style.setProperty('--mouse-x', `${me.clientX - rect.left}px`);
          (card as HTMLElement).style.setProperty('--mouse-y', `${me.clientY - rect.top}px`);
        });
      });

      // Whisper-subtle ambient field below the fold
      (function initAmbientParticles() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement | null;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let w = canvas.width = window.innerWidth;
        let h = canvas.height = window.innerHeight;
        const count = window.innerWidth < 768 ? 16 : 30;
        const particles: { x: number; y: number; vx: number; vy: number; r: number; }[] = [];

        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 0.22,
            vy: (Math.random() - 0.5) * 0.22,
            r: Math.random() * 1.3 + 0.5,
          });
        }

        window.addEventListener('resize', () => {
          w = canvas.width = window.innerWidth;
          h = canvas.height = window.innerHeight;
        }, { passive: true });

        const amber = [245, 158, 11];
        const cyan = [0, 212, 170];

        function phaseColor(x: number, y: number, alpha: number) {
          const t = Math.max(0, Math.min(1, (x / Math.max(w, 1)) * 0.65 + (y / Math.max(h, 1)) * 0.35));
          const r = Math.round(amber[0] + (cyan[0] - amber[0]) * t);
          const g = Math.round(amber[1] + (cyan[1] - amber[1]) * t);
          const b = Math.round(amber[2] + (cyan[2] - amber[2]) * t);
          return `rgba(${r},${g},${b},${alpha})`;
        }

        function draw() {
          ctx!.clearRect(0, 0, w, h);
          for (let i = 0; i < count; i++) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0) p.x = w;
            if (p.x > w) p.x = 0;
            if (p.y < 0) p.y = h;
            if (p.y > h) p.y = 0;

            ctx!.beginPath();
            ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx!.fillStyle = phaseColor(p.x, p.y, 0.22);
            ctx!.fill();
          }
          requestAnimationFrame(draw);
        }
        requestAnimationFrame(draw);
      })();
    </script>
    <script type="module" src="https://research.openie.dev/live/openie-ecosystem-dock.js" data-openie-surface="avalanche" defer is:inline></script>
  </body>
</html>
