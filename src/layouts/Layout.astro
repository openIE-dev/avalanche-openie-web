---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import RegisterSwitcher from '../components/RegisterSwitcher.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "OpenIE Avalanche — An open educational guide to evolutionary ratchets, the 9-Rung Computer Intelligence Avalanche, The Compilation Threshold, thermodynamic forcing functions, and falsifiable scientific forecasting."
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
---

<!DOCTYPE html>
<html lang="en" data-theme="dark" data-register="both">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00D4AA" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(pathname, 'https://avalanche.openie.dev').toString()} />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | OpenIE Avalanche</title>

    <meta property="og:title" content={`${title} | OpenIE Avalanche`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(pathname, 'https://avalanche.openie.dev').toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | OpenIE Avalanche`} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      (function(){
        var storedTheme = localStorage.getItem('oe-theme');
        var theme = storedTheme && ['dark','light','auto'].indexOf(storedTheme) !== -1 ? storedTheme : 'auto';
        if (theme === 'auto') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;

        var storedReg = localStorage.getItem('oe-avalanche-register');
        var reg = storedReg && ['both','visionary','scientist'].indexOf(storedReg) !== -1 ? storedReg : 'both';
        document.documentElement.setAttribute('data-register', reg);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col noise-overlay grid-bg">
    <canvas id="particle-canvas"></canvas>

    <nav id="nav" aria-label="Main navigation" class="nav-glass fixed top-0 left-0 right-0 z-100 px-4 lg:px-8 py-3.5 flex justify-between items-center transition-all duration-300">
      <a href="/" aria-label="OpenIE Avalanche educational home" class="font-display text-[20px] lg:text-[22px] font-bold tracking-tight text-brand-white no-underline hover:no-underline shrink-0">
        Open<span class="text-brand-cyan">IE</span> <span class="text-brand-amber">Avalanche</span>
      </a>

      <button id="mobile-menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links" class="xl:hidden flex flex-col gap-1.5 p-2 text-brand-slate cursor-pointer bg-transparent border-none">
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-top"></span>
        <span class="block w-5 h-0.5 bg-current transition-opacity" id="burger-mid"></span>
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-bot"></span>
      </button>

      <div id="nav-links" class="hidden xl:flex gap-5 items-center max-xl:fixed max-xl:inset-0 max-xl:top-[58px] max-xl:bg-brand-dark/96 max-xl:backdrop-blur-xl max-xl:flex-col max-xl:justify-center max-xl:gap-6 max-xl:z-50 max-xl:p-6">
        <a href={isHome ? "/#rungs" : "/rungs"} class:list={["font-body text-[13px] max-xl:text-base font-medium no-underline transition-colors", pathname.startsWith('/rungs') ? "text-brand-amber" : "text-brand-slate hover:text-brand-white"]}>
          The 9 Rungs
        </a>
        <a href="/#science" class="font-body text-[13px] max-xl:text-base font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">
          Science
        </a>
        <a href="/#forcing" class="font-body text-[13px] max-xl:text-base font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">
          Forcing Function
        </a>
        <a href={isHome ? "/#forecast" : "/forecast"} class:list={["font-body text-[13px] max-xl:text-base font-medium no-underline transition-colors", pathname.startsWith('/forecast') ? "text-brand-cyan" : "text-brand-slate hover:text-brand-white"]}>
          Forecast
        </a>
        <a href={isHome ? "/#ecosystem" : "/ecosystem"} class:list={["font-body text-[13px] max-xl:text-base font-medium no-underline transition-colors", pathname.startsWith('/ecosystem') ? "text-brand-cyan" : "text-brand-slate hover:text-brand-white"]}>
          Open Resources
        </a>
        <a href="/planetary" class:list={["font-mono text-[12px] max-xl:text-base font-semibold px-2.5 py-1 rounded-md border no-underline transition-colors", pathname.startsWith('/planetary') ? "border-brand-cyan bg-brand-cyan/15 text-brand-cyan" : "border-brand-cyan/35 text-brand-cyan hover:bg-brand-cyan/10"]}>
          Planetary Well
        </a>
        <a href="https://research.openie.dev/tv/?channel=avalanche" class="inline-flex items-center gap-1 font-mono text-[11px] max-xl:text-sm text-brand-amber border border-brand-amber/30 px-2.5 py-1 rounded-md no-underline hover:bg-brand-amber/10 hover:border-brand-amber transition-all" title="Watch Research TV — Avalanche Visual Explainers">
          <span aria-hidden="true">&#9654;</span> TV
        </a>
        <a href="https://research.openie.dev/radio/?desk=avalanche" class="inline-flex items-center gap-1 font-mono text-[11px] max-xl:text-sm text-brand-cyan border border-brand-cyan/30 px-2.5 py-1 rounded-md no-underline hover:bg-brand-cyan/10 hover:border-brand-cyan transition-all" title="Listen on Research Radio — Avalanche Audio Deep-Dives">
          <span aria-hidden="true">&#9673;</span> Radio
        </a>

        <div class="flex items-center gap-2.5 xl:ml-1 xl:pl-3 xl:border-l xl:border-brand-border">
          <RegisterSwitcher compact={true} label="Explanation Mode" />
          <ThemeToggle />
        </div>
      </div>
    </nav>

    <main class="flex-1 pt-16 relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 border-t border-brand-border px-6 md:px-10 py-12 mt-12" role="contentinfo">
      <div class="max-w-7xl mx-auto flex flex-col lg:flex-row justify-between items-start gap-10">
        <div class="max-w-xs">
          <div class="font-display text-base font-bold text-brand-white mb-2">
            Open<span class="text-brand-cyan">IE</span> <span class="text-brand-amber">Avalanche</span>
          </div>
          <p class="font-body text-[12px] text-brand-slate leading-relaxed mb-3">
            An open educational reference on evolutionary ratchets, the 9-Rung Computer Intelligence Avalanche, thermodynamic compilation thresholds, and falsifiable scientific forecasting.
          </p>
          <p class="font-mono text-[11px] text-brand-gray leading-relaxed">
            Zero trackers &middot; Self-hosted fonts &middot; Open science
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 md:gap-12 w-full lg:w-auto">
          <div>
            <div class="font-mono text-[10px] text-brand-amber tracking-[2px] uppercase mb-3">Study Guide</div>
            <div class="space-y-2">
              <a href="/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-white transition-colors">Observatory Home</a>
              <a href="/rungs" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-amber transition-colors">The 9 Rungs &amp; Seminar Guide</a>
              <a href="/planetary" class="block font-body text-[12px] text-brand-cyan no-underline hover:text-brand-white transition-colors">The Planetary Digital Well</a>
              <a href="/forecast" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">1950–2026 History &amp; Forecast</a>
              <a href="/ecosystem" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Open Papers, Labs &amp; Media</a>
            </div>
          </div>

          <div>
            <div class="font-mono text-[10px] text-brand-cyan tracking-[2px] uppercase mb-3">Primary Research &amp; Labs</div>
            <div class="space-y-2">
              <a href="https://research.openie.dev/papers/communication-avalanche/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Communication Avalanche Paper</a>
              <a href="https://research.openie.dev/papers/lut-adapt/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Downward LUT6 Paper</a>
              <a href="https://research.openie.dev/living/communication-avalanche/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Living Figures Observatory</a>
              <a href="https://research.openie.dev/tutorials/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">12 Interactive Labs</a>
              <a href="https://research.openie.dev/tv/?channel=avalanche" class="block font-body text-[12px] text-brand-amber no-underline hover:text-brand-gold transition-colors">&#9654; Research TV Explainers</a>
              <a href="https://research.openie.dev/radio/?desk=avalanche" class="block font-body text-[12px] text-brand-cyan no-underline hover:text-brand-teal transition-colors">&#9673; Research Radio Deep-Dives</a>
            </div>
          </div>

          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Sister Teaching Maps</div>
            <div class="space-y-1.5">
              <a href="https://stack.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Periodic Stack Overview</a>
              <a href="https://compute.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Compute Reference</a>
              <a href="https://synthesis.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Synthesis Reference</a>
              <a href="https://knowledge.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Knowledge Reference</a>
              <a href="https://database.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Database / Data Reference</a>
              <a href="https://state.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">State &amp; Memory Reference</a>
              <a href="https://communication.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Communication Reference</a>
              <a href="https://proof.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Formal Proof Reference</a>
            </div>
          </div>

          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Open Access &amp; Legal</div>
            <div class="space-y-1.5">
              <a href="https://research.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">research.openie.dev</a>
              <a href="/llms.txt" class="block font-mono text-[11px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">llms.txt</a>
              <a href="mailto:contact@openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Questions &amp; Errata</a>
              <a href="/terms" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Terms of Educational Use</a>
              <a href="/privacy" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Privacy (Zero Tracking)</a>
            </div>
          </div>
        </div>
      </div>

      <div class="max-w-7xl mx-auto mt-8 pt-6 border-t border-brand-border flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <p class="font-body text-[11px] text-brand-gray">&copy; {new Date().getFullYear()} Open Interface Engineering &middot; Educational Monograph Series. Free to read, link, and cite with attribution.</p>
        <p class="font-mono text-[10px] text-brand-gray">Telemetry strictly separated: <span class="text-brand-cyan">measured_j</span> &middot; <span class="text-brand-indigo">reported_j</span> &middot; <span class="text-brand-amber">est_j</span></p>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const navLinks = document.getElementById('nav-links');
      const burgerTop = document.getElementById('burger-top');
      const burgerMid = document.getElementById('burger-mid');
      const burgerBot = document.getElementById('burger-bot');
      let menuOpen = false;

      menuBtn?.addEventListener('click', () => {
        menuOpen = !menuOpen;
        navLinks?.classList.toggle('hidden', !menuOpen);
        navLinks?.classList.toggle('flex', menuOpen);
        menuBtn.setAttribute('aria-expanded', String(menuOpen));
        menuBtn.setAttribute('aria-label', menuOpen ? 'Close menu' : 'Open menu');
        if (burgerTop) burgerTop.style.transform = menuOpen ? 'rotate(45deg) translate(3px, 3px)' : '';
        if (burgerMid) burgerMid.style.opacity = menuOpen ? '0' : '1';
        if (burgerBot) burgerBot.style.transform = menuOpen ? 'rotate(-45deg) translate(3px, -3px)' : '';
      });

      navLinks?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          if (menuOpen) {
            menuOpen = false;
            navLinks.classList.add('hidden');
            navLinks.classList.remove('flex');
            if (burgerTop) burgerTop.style.transform = '';
            if (burgerMid) burgerMid.style.opacity = '1';
            if (burgerBot) burgerBot.style.transform = '';
          }
        });
      });

      const nav = document.getElementById('nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      const REG_KEY = 'oe-avalanche-register';
      const validRegs = ['both', 'visionary', 'scientist'];

      function syncRegisterButtons(reg: string) {
        document.documentElement.setAttribute('data-register', reg);
        document.querySelectorAll<HTMLButtonElement>('[data-set-register]').forEach(btn => {
          const isMatch = btn.getAttribute('data-set-register') === reg;
          btn.setAttribute('data-active', String(isMatch));
          btn.setAttribute('aria-pressed', String(isMatch));
        });
      }

      const initialReg = localStorage.getItem(REG_KEY);
      syncRegisterButtons(initialReg && validRegs.includes(initialReg) ? initialReg : 'both');

      document.querySelectorAll<HTMLButtonElement>('[data-set-register]').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-set-register') || 'both';
          if (validRegs.includes(target)) {
            localStorage.setItem(REG_KEY, target);
            syncRegisterButtons(target);
            window.dispatchEvent(new CustomEvent('oe-register-change', { detail: { register: target } }));
          }
        });
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.06 });
      document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));

      document.querySelectorAll('.spotlight-card').forEach(card => {
        card.addEventListener('mousemove', (e: Event) => {
          const me = e as MouseEvent;
          const rect = (card as HTMLElement).getBoundingClientRect();
          (card as HTMLElement).style.setProperty('--mouse-x', `${me.clientX - rect.left}px`);
          (card as HTMLElement).style.setProperty('--mouse-y', `${me.clientY - rect.top}px`);
        });
      });

      // Dual-Tone Phase-Transition Particle Canvas:
      // Left/top Phase 1 = Ephemeral Heat (Amber #F59E0B) -> Right/bottom Phase 2 = Compiled Substrates (Crystalline Cyan #00D4AA)
      (function initPhaseParticles() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement | null;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let w = canvas.width = window.innerWidth;
        let h = canvas.height = window.innerHeight;
        let mx = -9999, my = -9999;

        const count = window.innerWidth < 768 ? 36 : 74;
        const particles: { x: number; y: number; vx: number; vy: number; r: number; }[] = [];

        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 0.34,
            vy: (Math.random() - 0.5) * 0.34,
            r: Math.random() * 1.5 + 0.55,
          });
        }

        window.addEventListener('resize', () => {
          w = canvas.width = window.innerWidth;
          h = canvas.height = window.innerHeight;
        });
        document.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; }, { passive: true });
        document.addEventListener('mouseleave', () => { mx = -9999; my = -9999; });

        const amber = [245, 158, 11];
        const cyan = [0, 212, 170];

        function phaseColor(x: number, y: number, alpha: number) {
          const t = Math.max(0, Math.min(1, (x / Math.max(w, 1)) * 0.72 + (y / Math.max(h, 1)) * 0.28));
          const r = Math.round(amber[0] + (cyan[0] - amber[0]) * t);
          const g = Math.round(amber[1] + (cyan[1] - amber[1]) * t);
          const b = Math.round(amber[2] + (cyan[2] - amber[2]) * t);
          return `rgba(${r},${g},${b},${alpha})`;
        }

        function draw() {
          ctx!.clearRect(0, 0, w, h);
          for (let i = 0; i < count; i++) {
            const p = particles[i];
            if (mx > -9000) {
              const dx = mx - p.x;
              const dy = my - p.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 190 && dist > 0) {
                const force = (190 - dist) / 190 * 0.0075;
                p.vx += (dx / dist) * force;
                p.vy += (dy / dist) * force;
              }
            }
            const phaseT = p.x / Math.max(w, 1);
            const damp = phaseT > 0.55 ? 0.978 : 0.986;
            p.vx *= damp;
            p.vy *= damp;
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0) p.x = w;
            if (p.x > w) p.x = 0;
            if (p.y < 0) p.y = h;
            if (p.y > h) p.y = 0;

            ctx!.beginPath();
            ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx!.fillStyle = phaseColor(p.x, p.y, 0.42);
            ctx!.fill();

            for (let j = i + 1; j < count; j++) {
              const q = particles[j];
              const dx = p.x - q.x;
              const dy = p.y - q.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 118) {
                ctx!.beginPath();
                ctx!.moveTo(p.x, p.y);
                ctx!.lineTo(q.x, q.y);
                ctx!.strokeStyle = phaseColor((p.x + q.x) * 0.5, (p.y + q.y) * 0.5, 0.085 * (1 - dist / 118));
                ctx!.lineWidth = 0.55;
                ctx!.stroke();
              }
            }
          }
          requestAnimationFrame(draw);
        }
        requestAnimationFrame(draw);
      })();
    </script>
    <script src="https://scholar.askdavidc.ai/v22/embed/scholar-live.js" defer is:inline></script>
  </body>
</html>
